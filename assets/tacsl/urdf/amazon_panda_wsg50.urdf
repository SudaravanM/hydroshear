        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/gs_mini_meshes/gsmini_elastomer_transformed_enclosed.obj"/>
            </geometry>
        </collision>
    </link>

    <joint name="elastomer_tip_joint_left" type="fixed">
        <origin rpy="3.141592653589793 0 0" xyz="-0.00050001 -0.05975001 -0.01125"/>
        <parent link="panda_fingerbox_left"/>
        <child link="elastomer_tip_left"/>
        <axis xyz="0 0 0"/>
    </joint>
    <link name="elastomer_tip_left">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="1.0e-6"/>
            <inertia ixx="1.0e-09" ixy="0" ixz="0" iyy="1.0e-09" iyz="0" izz="1.0e-09"/>
        </inertial>
    </link>

     <!--   Finger tip links  -->
    <joint name="panda_fingertip_joint1" type="fixed">
        <parent link="panda_fingerbox_left"/>
        <child link="panda_leftfingertip"/>
        <!--0.08388700 (franka_finger_length)-->
        <origin rpy="0 0 0" xyz="0 -0.07688700 0"/>
    </joint>
    <link name="panda_leftfingertip">
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
