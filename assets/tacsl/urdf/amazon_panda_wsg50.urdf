    <!-- WSG Specific Code -->
    
    <!-- NOTE: it's link1, joint(link1,link2), link2 -->
    <joint name="wsg50_plate_joint" type="fixed">
        <parent link="panda_link7"/>
        <child link="wsg50_plate"/>
        <origin rpy="-1.57079633 0 0.7853981633974483" xyz="0 0 0.107"/>
    </joint>
    <link name="wsg50_plate">
        <visual>
            <origin rpy="-1.57079633 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/panda_wsg50_attachment.stl"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0.0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/panda_wsg50_attachment.stl"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.0"/> <!-- This is not the true mass -->
            <origin xyz="0 0 0"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/> <!-- This are not the true inertia -->
        </inertial>
    </link>

    <joint name="wsg50_anterior_gripper_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 -0.02 0.0"/>
        <parent link="wsg50_plate"/>
        <child link="wsg50_base_link"/>
    </joint>

    <link name="wsg50_base_link">
        <visual>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/WSG50_110.obj"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.57079633 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/WSG50_110.obj"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.48"/>
            <origin xyz="0.00363 -0.00829 0.015"/>
            <!--inertia ixx="1.0" ixy="0.0" ixz="0.0"
                iyy="100.0" iyz="0.0"
                izz="1.0" /-->
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <joint name="wsg50_center_joint" type="fixed">
        <origin xyz="0 0 0.023" rpy="0 0 0"/> <!-- 0.023 is finger length from gripper base -->
        <parent link="wsg50_base_link"/>
        <child link="wsg50_center"/>
    </joint>

    <link name="wsg50_center">
        <inertial>
            <mass value="0"/>
            <inertia ixx="0"  ixy="0"  ixz="0" iyy="0" iyz="0" izz="0" />
        </inertial>
    </link>

    <!-- Gripper Left -->
    <joint name="wsg50_left_finger_joint" type="prismatic">
        <limit lower="0.0" upper="0.055" effort="1.0" velocity="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>      <!--origin xyz="-0.0067 0 0.049" rpy="0 0 0" /-->
        <parent link="wsg50_base_link"/>
        <child link="wsg50_gripper_left"/>
        <dynamics friction="100" damping="100"/>
        <axis xyz="-1 0 0"/>
    </joint>

    <link name="wsg50_gripper_left">
        <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                         iyy="1.0" iyz="0.0"
                         izz="1.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/GUIDE_WSG50_110.obj" scale="0.001 0.001 0.001"/>
                <!--box size="0.0175 0.03 0.024"/-->
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.57079633 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/GUIDE_WSG50_110.obj" scale="0.001 0.001 0.001"/>
                <!--box size="0.0175 0.03 0.024"/-->
            </geometry>
        </collision>
    </link>

    <joint name="panda_leftfinger_joint" type="fixed">
        <origin xyz="-0.0255 -0.0805 0" rpy="0 -1.5707963267948966 0"/>
        <parent link="wsg50_gripper_left"/>
        <child link="panda_leftfinger"/>
        <dynamics friction="100" damping="100"/>
        <axis xyz="1 0 0"/>
        <limit effort="100" velocity="100"/>
    </joint>

    <link name="panda_leftfinger">
        <inertial>
            <mass value="0.1"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0"
                        iyy="1.0" iyz="0.0"
                        izz="1.0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/wsg50_finger_gsmini.stl"
                        scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.99 0.99 0.9 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.57079633 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="../mesh/schunk_meshes/wsg50_finger_gsmini.stl"
                        scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="panda_fingerbox_left_joint" type="fixed">
        <origin xyz="0 0.00 -0.015" rpy="0 0 0"/>
        <parent link="panda_leftfinger"/>
        <child link="panda_fingerbox_left"/>
    </joint>

    <link name="panda_fingerbox_left">
        <visual>
            <origin rpy="-1.5707963268 0 0" xyz="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="../mesh/gs_mini_meshes/gsmini_shell_hollow_transformed.obj"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/gs_mini_meshes/gsmini_shell_hollow_transformed.obj"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0.0114 0.0231"/>
            <mass value="0.0297"/>
            <inertia ixx="7.552e-06" ixy="0" ixz="0" iyy="7.159e-06" iyz="1.043e-6" izz="2.352e-06"/>
        </inertial>
    </link>

    <joint name="elastomer_joint_left" type="fixed">
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <parent link="panda_fingerbox_left"/>
        <child link="elastomer_left"/>
        <axis xyz="0 0 0"/>
    </joint>
    <link name="elastomer_left">         <!-- surface tip of the elastomer  -->
