    <joint name="panda_finger_centered_joint" type="fixed">
        <parent link="wsg50_plate"/>
        <child link="panda_finger_centered"/>
        <!--0.08040285 (franka_hand_to_finger_dist) + 0.08388700 (franka_finger_length) = 0.16428985-->
        <!-- -0.16028985 -0.0065 -->
        <origin rpy="1.57079633 0 0" xyz="0 -0.16688985 0"/>
    </joint>
    <link name="panda_finger_centered">
        <inertial>
