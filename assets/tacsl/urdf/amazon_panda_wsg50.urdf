            <inertia ixx="1.0e-09" ixy="0" ixz="0" iyy="1.0e-09" iyz="0" izz="1.0e-09"/>
        </inertial>
    </link>

    <!-- Gripper Right -->
    <joint name="wsg50_right_finger_joint" type="prismatic">
        <limit lower="0.00" upper="0.055" effort="1.0" velocity="1.0"/>
        <origin xyz="0 0 0" rpy="0 -3.14159 0"/>
        <parent link="wsg50_base_link"/>
        <child link="wsg50_gripper_right"/>
        <dynamics friction="100" damping="100"/>
        <axis xyz="-1 0 0"/>
    </joint>

    <link name="wsg50_gripper_right">
        <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0"/>
